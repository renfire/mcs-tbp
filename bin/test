#!/usr/bin/env sh
#
# Runs the TBP test suite inside Docker, so no local PHP installation is needed.
#
# Usage:
#   bin/test                        run the whole suite
#   bin/test --filter testEnvVar    any extra argument is passed to PHPUnit
#   PHP_VERSION=8.1 bin/test        run against another PHP version (8.1 or newer)

set -eu

cd "$(dirname "$0")/.."

PHP_VERSION="${PHP_VERSION:-8.3}"
IMAGE="tbp-test:php${PHP_VERSION}"

docker build --quiet \
    --build-arg PHP_VERSION="$PHP_VERSION" \
    -f docker/test.Dockerfile \
    -t "$IMAGE" \
    . >/dev/null

# Allocate a TTY only when there is one (keeps colours locally, works in CI).
TTY=""
if [ -t 1 ]; then
    TTY="-t"
fi

exec docker run --rm $TTY "$IMAGE" "$@"
