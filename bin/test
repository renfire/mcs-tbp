#!/usr/bin/env sh
#
# Runs the TBP test suite inside Docker, so no local PHP installation is needed. The databases used by the
# integration tests (PostgreSQL 17) are started before the tests and removed afterwards.
#
# Usage:
#   bin/test                        run the whole suite
#   bin/test --filter testEnvVar    any extra argument is passed to PHPUnit
#   PHP_VERSION=8.5.10 bin/test     use another php Docker image tag (default: 8.5, the minimum supported)

set -eu

cd "$(dirname "$0")/.."

export PHP_VERSION="${PHP_VERSION:-8.5}"
COMPOSE="docker compose --progress quiet -f docker/test.compose.yaml"

cleanup() {
    $COMPOSE down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

$COMPOSE build --quiet tests

# Allocate a TTY only when there is one (keeps colours locally, works in CI).
TTY="-T"
if [ -t 1 ]; then
    TTY=""
fi

$COMPOSE run --rm --quiet-pull $TTY tests "$@"
