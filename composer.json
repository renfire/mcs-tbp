{
    "name": "renfire/tbp",
    "type": "library",
    "description": "Light component-oriented PHP framework for small and medium websites",
    "keywords": ["tbp", "framework", "component", "widget", "template", "mysql", "postgresql", "sqlserver", "sqlite", "redis"],
    "homepage": "https://github.com/renfire/mcs-tbp",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Marc Clausell",
            "role": "Maintainer"
        },
        {
            "name": "Bitendian S.L.",
            "email": "info@bitendian.com",
            "homepage": "http://www.bitendian.com",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/renfire/mcs-tbp/issues",
        "source": "https://github.com/renfire/mcs-tbp"
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    },
    "suggest": {
        "ext-pdo_pgsql": "PostgreSQL connection implementation",
        "ext-mysqli": "MySQL connection implementation",
        "predis/predis": "Redis connection implementation"
    },
    "conflict": {
        "bitendian/tbp": "*"
    },
    "autoload": {
        "psr-4": {
            "Bitendian\\TBP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bitendian\\TBP\\Tests\\": "test/src/"
        }
    }
}
